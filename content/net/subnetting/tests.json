{
  "module": "net.subnetting",
  "cases": [
    {
      "ip": "192.168.10.130",
      "prefix": 25,
      "expect": {
        "mask": "255.255.255.128",
        "network": "192.168.10.128",
        "broadcast": "192.168.10.255",
        "hosts": 126
      }
    },
    {
      "ip": "10.0.0.7",
      "prefix": 24,
      "expect": {
        "network": "10.0.0.0",
        "broadcast": "10.0.0.255",
        "hosts": 254
      }
    },
    {
      "ip": "192.168.1.6",
      "prefix": 30,
      "expect": {
        "network": "192.168.1.4",
        "broadcast": "192.168.1.7",
        "hosts": 2
      }
    }
  ]
}
